---
type DataRow = Record<string, any>;

const { scene } = Astro.props as {
  scene: DataRow;
};
const durationText = (milliseconds?: number | null) => {
  const totalSeconds = Math.round((milliseconds ?? 0) / 1000);
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;
  return `${minutes}:${String(seconds).padStart(2, '0')}`;
};
const groupLabels: Record<string, string> = {
  battle_event: '战中剧情 CG',
  conditional_ending: '条件结局 CG',
  finale: '最终结局 CG',
  intro: '战前剧情 CG',
  outro: '战后剧情 CG',
};
const title = groupLabels[scene.group] ?? '剧情 CG';
---

<figure class="tdj-story-movie">
  <div class="tdj-story-movie-heading">
    <div>
      <h3>{title}</h3>
      <small>
        {scene.name} · {scene.triggerLabel} · {scene.width} × {scene.height} · {scene.frameRate} fps · {durationText(scene.durationMs)}
        {scene.hasAudio ? ' · 原声' : ' · 无声'}
      </small>
    </div>
    <span>可全屏播放</span>
  </div>
  <video
    controls
    playsinline
    preload="metadata"
    poster={scene.posterPath}
    width={scene.width}
    height={scene.height}
  >
    <source src={scene.moviePath} type="video/mp4" />
    当前浏览器无法播放这段 MP4 影片。
  </video>
  {(scene.contextBefore || scene.contextAfter) && (
    <figcaption>
      {scene.contextBefore && <span><strong>播放前：</strong>{scene.contextBefore}</span>}
      {scene.contextAfter && <span><strong>播放后：</strong>{scene.contextAfter}</span>}
    </figcaption>
  )}
</figure>

<style>
  .tdj-story-movie {
    background: var(--leaf-bg-card);
    border: 1px solid var(--leaf-border);
    border-radius: var(--leaf-radius-card);
    box-shadow: var(--leaf-shadow-card);
    margin: 0.75rem 0;
    overflow: hidden;
  }

  .tdj-story-movie-heading {
    align-items: center;
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    padding: 0.7rem 0.8rem;
  }

  .tdj-story-movie-heading div {
    display: grid;
    gap: 0.12rem;
  }

  .tdj-story-movie-heading h3 {
    color: var(--leaf-heading);
    font-size: 1rem;
    margin: 0;
  }

  .tdj-story-movie-heading small,
  .tdj-story-movie figcaption {
    color: var(--leaf-text-muted);
  }

  .tdj-story-movie-heading > span {
    background: var(--leaf-bg-subtle);
    border: 1px solid var(--leaf-border);
    border-radius: 999px;
    flex: 0 0 auto;
    font-size: 0.76rem;
    padding: 0.2rem 0.5rem;
  }

  .tdj-story-movie video {
    background: #050505;
    display: block;
    height: auto;
    image-rendering: auto;
    max-height: 72vh;
    width: 100%;
  }

  .tdj-story-movie figcaption {
    display: grid;
    font-size: 0.82rem;
    gap: 0.3rem;
    padding: 0.65rem 0.8rem;
  }

  .tdj-story-movie figcaption span {
    white-space: pre-line;
  }

  @media (max-width: 40rem) {
    .tdj-story-movie-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
