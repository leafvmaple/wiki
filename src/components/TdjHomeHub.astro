---
import summary from '../data/sword-man/generated/summary.json';
import battles from '../data/sword-man/generated/battles.json';

const { counts, assets } = summary;
const firstBattles = battles.slice(0, 4);
const heroImage = assets.titleScreen ?? assets.showcase;

const statCards = [
  { value: counts.characters, label: '角色' },
  { value: counts.skills, label: '技能' },
  { value: counts.weapons + counts.items, label: '武器与道具' },
  { value: counts.alchemyRecipes, label: '炼化配方' },
  { value: counts.monsters, label: '单位' },
  { value: counts.battles, label: '关卡' },
];

const entries = [
  { label: '角色资料', href: '/games/sword-man/characters/', meta: '成长、装备、习得技能' },
  { label: '技能法术', href: '/games/sword-man/skills/', meta: '消耗、范围、属性、说明' },
  { label: '武器列表', href: '/games/sword-man/equipment/weapons/', meta: '属性、适用角色、战斗使用' },
  { label: '道具列表', href: '/games/sword-man/items/', meta: '效果、威力、价格与说明' },
  { label: '装备炼化', href: '/games/sword-man/alchemy/equipment/', meta: '武器、防具、饰品配方与属性' },
  { label: '道具炼化', href: '/games/sword-man/alchemy/items/', meta: '回复、成长、符咒配方与效果' },
  { label: '怪物图鉴', href: '/games/sword-man/monsters/', meta: '等级、HP、攻防、成长' },
  { label: '关卡资料', href: '/games/sword-man/battles/', meta: '出战、敌人、地图与战场音乐' },
  { label: '音乐一览', href: '/games/sword-man/music/', meta: `${counts.musicTracks} 首原版音乐，可直接试听` },
  { label: '营地资料', href: '/games/sword-man/camps/', meta: '角色与场景合成预览' },
  { label: '数据说明', href: '/games/sword-man/data-notes/', meta: '来源、字段与同步方式' },
];
---

<section class="tdj-hub" aria-label="天地劫资料入口">
  <div
    class="tdj-hero"
    style={heroImage ? `--tdj-hero-art: url("${heroImage}")` : undefined}
  >
    <div class="tdj-hero-copy">
      <p class="tdj-kicker">天地劫·神魔至尊传 · canonical v{summary.dataset.schemaVersion}</p>
      <h2>攻略资料库</h2>
      <p>围绕角色成长、技能法术、怪物单位与关卡资料，整理成可检索的 wiki 分区。</p>
      <div class="tdj-actions">
        <a href="/games/sword-man/characters/">查角色</a>
        <a href="/games/sword-man/battles/">看关卡</a>
        <a href="/games/sword-man/skills/">翻技能</a>
        <a href="/games/sword-man/alchemy/equipment/">查炼化</a>
      </div>
    </div>
    <div class="tdj-stat-grid" aria-label="数据规模">
      {statCards.map((item) => (
        <span>
          <strong>{item.value}</strong>
          <em>{item.label}</em>
        </span>
      ))}
    </div>
    {heroImage && (
      <img
        class="tdj-title-image"
        src={heroImage}
        alt="天地劫：神魔至尊传原版标题画面"
        width="330"
        height="192"
        loading="eager"
        fetchpriority="high"
      />
    )}
  </div>

  <div class="tdj-entry-grid" aria-label="常用入口">
    {entries.map((entry) => (
      <a href={entry.href}>
        <span>{entry.label}</span>
        <small>{entry.meta}</small>
      </a>
    ))}
  </div>

  <section class="tdj-battle-overview">
    <h3>关卡速览</h3>
    <div class="tdj-battle-list">
      {firstBattles.map((battle) => (
        <a href={battle.href}>
          <strong>{battle.displayTitle}</strong>
          <span>{battle.map.width} × {battle.map.height} / 敌方 {battle.enemyCount}</span>
          <small>{battle.id} · {battle.enemyNames.join('、') || '敌方待整理'}</small>
        </a>
      ))}
    </div>
  </section>
</section>

<style>
  .tdj-hub {
    display: grid;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .tdj-hero {
    border: 1px solid var(--leaf-border);
    border-radius: var(--leaf-radius-card);
    background: #0c0907;
    box-shadow: var(--leaf-shadow-card);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 19rem;
    overflow: hidden;
    padding: 1.35rem;
    position: relative;
  }

  .tdj-hero::before {
    background: var(--tdj-hero-art) center / cover no-repeat;
    content: '';
    filter: blur(18px) saturate(0.85);
    inset: -1.5rem;
    opacity: 0.32;
    pointer-events: none;
    position: absolute;
    transform: scale(1.08);
    z-index: 0;
  }

  .tdj-hero::after {
    background: linear-gradient(
      98deg,
      rgba(7, 8, 11, 0.98) 0%,
      rgba(7, 8, 11, 0.95) 38%,
      rgba(7, 8, 11, 0.72) 51%,
      rgba(7, 8, 11, 0.22) 75%,
      rgba(7, 8, 11, 0.08) 100%
    );
    content: '';
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 2;
  }

  .tdj-hero-copy {
    max-width: 55%;
    position: relative;
    z-index: 3;
  }

  .tdj-hero .tdj-stat-grid {
    max-width: none;
    position: relative;
    z-index: 3;
  }

  .tdj-kicker {
    color: #8fd0f2;
    font-size: 0.82rem;
    font-weight: 800;
    margin: 0;
  }

  .tdj-hero h2 {
    color: #fff;
    font-size: 1.72rem;
    line-height: 1.16;
    margin: 0.2rem 0 0.55rem;
  }

  .tdj-hero p:last-of-type {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    margin: 0;
  }

  .tdj-actions,
  .tdj-entry-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .tdj-actions a,
  .tdj-entry-grid a {
    border: 1px solid rgba(35, 183, 229, 0.34);
    border-radius: var(--leaf-radius-card);
    color: var(--leaf-primary-hover);
    font-weight: 800;
    line-height: 1.15;
    text-decoration: none;
  }

  .tdj-actions a {
    backdrop-filter: blur(3px);
    background: rgba(8, 13, 22, 0.48);
    color: #8fd0f2;
    padding: 0.45rem 0.7rem;
  }

  .tdj-actions a:hover,
  .tdj-entry-grid a:hover {
    border-color: var(--leaf-primary);
    color: var(--leaf-primary);
  }

  .tdj-title-image {
    display: block;
    filter: saturate(0.9) contrast(0.96) brightness(0.94);
    height: 123%;
    image-rendering: pixelated;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.8) 8%, #000 18%);
    mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.8) 8%, #000 18%);
    object-fit: contain;
    position: absolute;
    right: 0;
    top: -20%;
    transform: translateX(3.2%);
    width: auto;
    z-index: 1;
  }

  .tdj-stat-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .tdj-stat-grid span,
  .tdj-entry-grid a,
  .tdj-battle-overview {
    border: 1px solid var(--leaf-border);
    border-radius: var(--leaf-radius-card);
    background: var(--leaf-bg-card);
    box-shadow: var(--leaf-shadow-card);
  }

  .tdj-stat-grid span {
    display: grid;
    gap: 0.08rem;
    min-width: 4.2rem;
    padding: 0.48rem 0.65rem;
  }

  .tdj-stat-grid strong {
    color: var(--leaf-heading);
    font-size: 1.35rem;
    line-height: 1;
  }

  .tdj-stat-grid em {
    color: var(--leaf-text);
    font-style: normal;
    font-weight: 800;
    font-size: 0.8rem;
  }

  .tdj-hero .tdj-stat-grid span {
    backdrop-filter: blur(3px);
    background: rgba(8, 13, 22, 0.52);
    border-color: rgba(255, 255, 255, 0.16);
  }

  .tdj-hero .tdj-stat-grid strong {
    color: #fff;
  }

  .tdj-hero .tdj-stat-grid em {
    color: rgba(255, 255, 255, 0.8);
  }

  .tdj-stat-grid small,
  .tdj-entry-grid small,
  .tdj-battle-list small {
    color: var(--leaf-text-muted);
  }

  .tdj-entry-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 0;
  }

  .tdj-entry-grid a {
    display: grid;
    gap: 0.28rem;
    padding: 0.78rem 0.85rem;
  }

  .tdj-battle-overview {
    padding: 0.9rem;
  }

  .tdj-battle-overview h3 {
    color: var(--leaf-heading);
    font-size: 1.05rem;
    margin: 0 0 0.65rem;
  }

  .tdj-battle-list {
    display: grid;
    gap: 0.46rem;
  }

  .tdj-battle-list a {
    border: 1px solid var(--leaf-border);
    border-radius: var(--leaf-radius-card);
    color: var(--leaf-text);
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0.65rem;
    text-decoration: none;
  }

  .tdj-battle-list a:hover {
    border-color: rgba(35, 183, 229, 0.46);
    color: var(--leaf-primary-hover);
  }

  .tdj-battle-list strong {
    color: var(--leaf-heading);
  }

  @media (max-width: 58rem) {
    .tdj-entry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tdj-hero-copy {
      max-width: 64%;
    }

    .tdj-hero .tdj-stat-grid {
      max-width: none;
    }
  }

  @media (max-width: 34rem) {
    .tdj-hero {
      min-height: 0;
      padding: 0.9rem;
    }

    .tdj-hero::after {
      background: linear-gradient(180deg, rgba(7, 8, 11, 0.98) 0%, rgba(7, 8, 11, 0.92) 52%, rgba(7, 8, 11, 0.2) 78%, rgba(7, 8, 11, 0) 100%);
    }

    .tdj-hero::before {
      opacity: 0.18;
    }

    .tdj-hero-copy,
    .tdj-hero .tdj-stat-grid {
      max-width: none;
    }

    .tdj-title-image {
      filter: none;
      height: auto;
      inset: auto;
      margin: 0.9rem -0.9rem -0.9rem;
      -webkit-mask-image: none;
      mask-image: none;
      max-width: none;
      order: 3;
      position: relative;
      transform: none;
      width: calc(100% + 2.45rem);
    }

    .tdj-hero h2 {
      font-size: 1.42rem;
    }

    .tdj-stat-grid,
    .tdj-entry-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
