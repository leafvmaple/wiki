---
import { daikoukai2Ships } from '../data/daikoukai2/ships';
import {
  daikoukai2LowerCommerceByShip,
  daikoukai2UpperRegionsByShip,
} from '../data/daikoukai2/usedShips';

const rows = daikoukai2Ships.map((ship) => ({
  ...ship,
  upperRegions: daikoukai2UpperRegionsByShip[ship.id],
  lowerCommerce: daikoukai2LowerCommerceByShip[ship.id],
}));
---

<div class="dk2-ships not-content" data-unit="种">
  <div class="dk2-ships-bar">
    <input
      class="dk2-ships-search"
      type="search"
      placeholder="搜索船型……"
      aria-label="搜索船型"
    />
    <span class="dk2-ships-count" aria-live="polite"></span>
  </div>

  <div class="dk2-ships-scroll" tabindex="0" aria-label="船型性能数据表，可横向滚动">
    <table class="dk2-ships-table">
      <thead>
        <tr>
          <th data-sort="id" class="num">ID</th>
          <th data-sort="name">船型</th>
          <th data-sort="price" class="num">基准价</th>
          <th data-sort="industry" class="num">新造工业</th>
          <th>上 3 格造船圈</th>
          <th data-sort="lowerCommerce" class="num">下 2 格商业</th>
          <th data-sort="turning" class="num">旋回</th>
          <th data-sort="propulsion" class="num">推进</th>
          <th data-sort="durability" class="num">耐久</th>
          <th data-sort="requiredCrew" class="num">最低水手</th>
          <th data-sort="usedCrew" class="num">中古水手</th>
          <th data-sort="maxCrew" class="num">最大水手</th>
          <th data-sort="usedCannons" class="num">中古炮门</th>
          <th data-sort="maxCannons" class="num">最大炮门</th>
          <th data-sort="usedCargo" class="num">中古货舱</th>
          <th data-sort="capacity" class="num">总载重</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((ship) => (
          <tr
            data-id={ship.id}
            data-name={ship.nameJa}
            data-price={ship.baseUsedPrice}
            data-industry={ship.requiredIndustry}
            data-lower-commerce={ship.lowerCommerce ?? -1}
            data-turning={ship.turning}
            data-propulsion={ship.propulsion}
            data-durability={ship.durability}
            data-required-crew={ship.requiredCrew}
            data-used-crew={ship.usedCrew}
            data-max-crew={ship.maxCrew}
            data-used-cannons={ship.usedCannons}
            data-max-cannons={ship.maxCannons}
            data-used-cargo={ship.usedCargo}
            data-capacity={ship.totalCapacity}
            data-search={`${ship.nameJa} ${ship.upperRegions.join(' ')}`}
          >
            <td class="num dk2-ships-id">{ship.id}</td>
            <td class="dk2-ships-name">{ship.nameJa}</td>
            <td class="num dk2-ships-price">{ship.baseUsedPrice.toLocaleString('zh-CN')}</td>
            <td class="num">{ship.requiredIndustry}</td>
            <td class="dk2-ships-regions">{ship.upperRegions.join('、')}</td>
            <td class="num">{ship.lowerCommerce ?? '—'}</td>
            <td class="num">{ship.turning}</td>
            <td class="num">{ship.propulsion}</td>
            <td class="num">{ship.durability}</td>
            <td class="num dk2-ships-required">{ship.requiredCrew}</td>
            <td class="num">{ship.usedCrew}</td>
            <td class="num">{ship.maxCrew}</td>
            <td class="num">{ship.usedCannons}</td>
            <td class="num">{ship.maxCannons}</td>
            <td class="num">{ship.usedCargo}</td>
            <td class="num">{ship.totalCapacity}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.dk2-ships').forEach((root) => {
    const table = root.querySelector<HTMLTableElement>('table');
    const tbody = table?.querySelector('tbody');
    if (!table || !tbody) return;
    const rows = [...tbody.querySelectorAll<HTMLElement>('tr')];
    const search = root.querySelector<HTMLInputElement>('.dk2-ships-search');
    const count = root.querySelector<HTMLElement>('.dk2-ships-count');
    let sortKey = '';
    let sortDir = 1;

    const apply = () => {
      const query = search?.value.trim().toLocaleLowerCase('ja') ?? '';
      let shown = 0;
      for (const row of rows) {
        const matches = !query || (row.dataset.search ?? '').toLocaleLowerCase('ja').includes(query);
        row.hidden = !matches;
        if (matches) shown += 1;
      }
      if (count) count.textContent = `${shown} 种`;
    };

    const sortBy = (heading: HTMLElement) => {
      const key = heading.dataset.sort;
      if (!key) return;
      if (sortKey === key) sortDir *= -1;
      else {
        sortKey = key;
        sortDir = heading.classList.contains('num') ? -1 : 1;
      }
      const numeric = heading.classList.contains('num');
      [...rows]
        .sort((a, b) => {
          const av = a.dataset[key] ?? '';
          const bv = b.dataset[key] ?? '';
          return numeric
            ? (Number(av) - Number(bv)) * sortDir
            : av.localeCompare(bv, 'ja') * sortDir;
        })
        .forEach((row) => tbody.appendChild(row));
      table.querySelectorAll<HTMLElement>('th[data-sort]').forEach((item) => {
        item.dataset.dir = item.dataset.sort === key ? (sortDir > 0 ? 'asc' : 'desc') : '';
      });
    };

    search?.addEventListener('input', apply);
    table.querySelectorAll<HTMLElement>('th[data-sort]').forEach((heading) => {
      heading.addEventListener('click', () => sortBy(heading));
    });
    apply();
  });
</script>

<style>
  .dk2-ships {
    display: grid;
    gap: 0.7rem;
    margin: 1rem 0;
  }

  .dk2-ships-bar {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .dk2-ships-search {
    border: 1px solid var(--leaf-border);
    border-radius: var(--leaf-radius-card);
    background: var(--leaf-bg-card);
    color: var(--leaf-text);
    flex: 1 1 15rem;
    font: inherit;
    font-size: 0.9rem;
    max-width: 25rem;
    padding: 0.38rem 0.6rem;
  }

  .dk2-ships-count {
    color: var(--leaf-text-muted);
    font-size: 0.85rem;
    font-weight: 700;
    margin-left: auto;
  }

  .dk2-ships-scroll {
    border: 1px solid var(--leaf-border);
    border-radius: var(--leaf-radius-card);
    overflow-x: auto;
  }

  .dk2-ships-scroll:focus-visible {
    outline: 2px solid var(--leaf-primary);
    outline-offset: 2px;
  }

  .dk2-ships-table {
    border-collapse: collapse;
    font-size: 0.86rem;
    min-width: 92rem;
    width: 100%;
  }

  .dk2-ships-table :is(th, td) {
    border-bottom: 1px solid var(--leaf-border);
    padding: 0.43rem 0.55rem;
    text-align: left;
    vertical-align: middle;
    white-space: nowrap;
  }

  .dk2-ships-table th {
    background: var(--leaf-bg-subtle);
    color: var(--leaf-text-muted);
    font-weight: 800;
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .dk2-ships-table th[data-sort] {
    cursor: pointer;
    user-select: none;
  }

  .dk2-ships-table th[data-sort]:hover {
    color: var(--leaf-primary-hover);
  }

  .dk2-ships-table th[data-sort]::after {
    content: ' ↕';
    opacity: 0.28;
  }

  .dk2-ships-table th[data-dir='asc']::after {
    content: ' ↑';
    opacity: 1;
  }

  .dk2-ships-table th[data-dir='desc']::after {
    content: ' ↓';
    opacity: 1;
  }

  .dk2-ships-table tbody tr:nth-child(even) {
    background: var(--leaf-table-stripe);
  }

  .dk2-ships-table tbody tr:hover {
    background: var(--leaf-table-hover);
  }

  .dk2-ships-table .num {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .dk2-ships-id,
  .dk2-ships-price {
    color: var(--leaf-text-muted);
  }

  .dk2-ships-name {
    color: var(--leaf-heading);
    font-weight: 750;
  }

  .dk2-ships-regions {
    line-height: 1.45;
    min-width: 10rem;
    white-space: normal;
  }

  .dk2-ships-required {
    color: var(--leaf-primary-hover);
    font-weight: 750;
  }

  @media (max-width: 40rem) {
    .dk2-ships-search {
      flex-basis: 100%;
      max-width: none;
      min-width: 0;
    }

    .dk2-ships-count {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
