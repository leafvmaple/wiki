<script>
  type TooltipCard = {
    imageSrc?: string;
    kicker?: string;
    title?: string;
    body?: string;
    stats?: string[];
    href?: string;
  };

  const tooltipWindow = window as Window & { __svEntityTooltipReady?: boolean };

  if (!tooltipWindow.__svEntityTooltipReady) {
    tooltipWindow.__svEntityTooltipReady = true;

    const parseCard = (target: HTMLElement): TooltipCard | null => {
      try {
        return JSON.parse(target.dataset.svCard || 'null');
      } catch {
        return null;
      }
    };

    const ensureTooltip = (): HTMLElement => {
      let tooltip = document.querySelector<HTMLElement>('.sv-entity-tooltip');
      if (tooltip) return tooltip;

      tooltip = document.createElement('div');
      tooltip.className = 'sv-entity-tooltip';
      tooltip.hidden = true;
      document.body.append(tooltip);
      return tooltip;
    };

    const renderTooltip = (tooltip: HTMLElement, card: TooltipCard) => {
      tooltip.replaceChildren();

      const header = document.createElement('div');
      header.className = 'sv-entity-tooltip-header';

      if (card.imageSrc) {
        const imageWrap = document.createElement('span');
        imageWrap.className = 'sv-entity-tooltip-image';
        const image = document.createElement('img');
        image.src = card.imageSrc;
        image.alt = '';
        image.loading = 'lazy';
        image.decoding = 'async';
        imageWrap.append(image);
        header.append(imageWrap);
      }

      const titleWrap = document.createElement('span');
      titleWrap.className = 'sv-entity-tooltip-title';
      const kicker = document.createElement('span');
      kicker.className = 'sv-entity-tooltip-kicker';
      kicker.textContent = card.kicker || '条目';
      const title = document.createElement('strong');
      title.textContent = card.title || '条目';
      titleWrap.append(kicker, title);
      header.append(titleWrap);

      const body = document.createElement('p');
      body.textContent = card.body || '';

      tooltip.append(header, body);

      if (Array.isArray(card.stats) && card.stats.length) {
        const stats = document.createElement('div');
        stats.className = 'sv-entity-tooltip-stats';
        for (const item of card.stats.slice(0, 5)) {
          const stat = document.createElement('span');
          stat.textContent = item;
          stats.append(stat);
        }
        tooltip.append(stats);
      }
    };

    const placeTooltip = (tooltip: HTMLElement, target: Element) => {
      const rect = target.getBoundingClientRect();
      const gap = 10;
      const width = tooltip.offsetWidth;
      const height = tooltip.offsetHeight;
      const viewportWidth = document.documentElement.clientWidth;
      const viewportHeight = document.documentElement.clientHeight;

      let left = rect.left + rect.width / 2 - width / 2;
      let top = rect.bottom + gap;

      if (top + height + gap > viewportHeight) {
        top = rect.top - height - gap;
      }

      left = Math.max(12, Math.min(left, viewportWidth - width - 12));
      top = Math.max(12, Math.min(top, viewportHeight - height - 12));

      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${top}px`;
    };

    let activeTarget: Element | null = null;

    const showTooltip = (target: Element) => {
      if (!(target instanceof HTMLElement)) return;
      const card = parseCard(target);
      if (!card) return;
      const tooltip = ensureTooltip();
      activeTarget = target;
      renderTooltip(tooltip, card);
      tooltip.hidden = false;
      tooltip.classList.add('is-visible');
      requestAnimationFrame(() => placeTooltip(tooltip, target));
    };

    const hideTooltip = (target?: Element | null) => {
      if (target && activeTarget && target !== activeTarget) return;
      const tooltip = document.querySelector<HTMLElement>('.sv-entity-tooltip');
      activeTarget = null;
      if (!tooltip) return;
      tooltip.classList.remove('is-visible');
      tooltip.hidden = true;
    };

    document.addEventListener(
      'pointerover',
      (event) => {
        const target = event.target instanceof Element ? event.target.closest('[data-sv-card]') : null;
        const related = event.relatedTarget instanceof Node ? event.relatedTarget : null;
        if (!target || (related && target.contains(related))) return;
        showTooltip(target);
      },
      true
    );

    document.addEventListener(
      'pointerout',
      (event) => {
        const target = event.target instanceof Element ? event.target.closest('[data-sv-card]') : null;
        const related = event.relatedTarget instanceof Node ? event.relatedTarget : null;
        if (!target || (related && target.contains(related))) return;
        hideTooltip(target);
      },
      true
    );

    document.addEventListener('focusin', (event) => {
      const target = event.target instanceof Element ? event.target.closest('[data-sv-card]') : null;
      if (target) showTooltip(target);
    });

    document.addEventListener('focusout', (event) => {
      const target = event.target instanceof Element ? event.target.closest('[data-sv-card]') : null;
      if (target) hideTooltip(target);
    });

    window.addEventListener('scroll', () => hideTooltip(), { passive: true });
    window.addEventListener('resize', () => hideTooltip(), { passive: true });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') hideTooltip();
    });
  }
</script>

<style is:global>
  .sv-entity-tooltip {
    border: 1px solid color-mix(in srgb, var(--leaf-primary) 22%, var(--leaf-border));
    border-radius: var(--leaf-radius-card);
