  }

  .sv-entity-tooltip-header {
    align-items: center;
    display: flex;
    gap: 0.72rem;
    min-width: 0;
  }

  .sv-entity-tooltip-image {
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--leaf-primary) 24%, var(--leaf-border));
    border-radius: 6px;
    background: color-mix(in srgb, var(--leaf-bg) 84%, var(--leaf-primary));
    display: inline-flex;
    flex: 0 0 auto;
    height: 2.55rem;
    justify-content: center;
    padding: 0.18rem;
    width: 2.55rem;
  }

  .sv-entity-tooltip-image img {
    display: block;
    height: 100%;
    image-rendering: pixelated;
    object-fit: contain;
    width: 100%;
  }

  .sv-entity-tooltip-title {
    display: grid;
    gap: 0.24rem;
    min-width: 0;
  }

  .sv-entity-tooltip-title strong {
    color: var(--leaf-heading);
    font-size: 1.06rem;
    line-height: 1.22;
    overflow-wrap: anywhere;
  }

  .sv-entity-tooltip-kicker {
    border: 1px solid color-mix(in srgb, var(--leaf-primary) 28%, var(--leaf-border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--leaf-primary) 12%, var(--leaf-bg));
    color: color-mix(in srgb, var(--leaf-primary-hover) 82%, var(--leaf-heading));
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1;
    padding: 0.18rem 0.42rem;
    width: fit-content;
  }

  .sv-entity-tooltip p {
    color: var(--leaf-text);
    font-size: 0.86rem;
    line-height: 1.45;
    margin: 0.72rem 0 0;
  }

  .sv-entity-tooltip-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
    margin-top: 0.72rem;
  }

  .sv-entity-tooltip-stats span {
    border: 1px solid color-mix(in srgb, var(--leaf-primary) 28%, var(--leaf-border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--leaf-primary) 10%, var(--leaf-bg));
    color: var(--leaf-heading);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.2;
    padding: 0.22rem 0.5rem;
  }

  .sv-entity-tooltip-stats span:nth-child(2n) {
    border-color: color-mix(in srgb, var(--leaf-accent-green) 34%, var(--leaf-border));
    background: color-mix(in srgb, var(--leaf-accent-green) 11%, var(--leaf-bg));
  }

  :root[data-theme='dark'] .sv-entity-tooltip-kicker,
  :root[data-theme='dark'] .sv-entity-tooltip-stats span {
    background: color-mix(in srgb, var(--leaf-primary) 16%, var(--leaf-bg-card));
  }

  :root[data-theme='dark'] .sv-entity-tooltip-stats span:nth-child(2n) {
    background: color-mix(in srgb, var(--leaf-accent-green) 14%, var(--leaf-bg-card));
  }
</style>
