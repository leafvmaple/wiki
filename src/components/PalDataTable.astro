---
// 仙剑一数据表 — 可筛选排序。
// kinds: items | equipment | shops | locations | treasures | npcs
//        | enemies | magics | sources
import items from '../data/pal/generated/items.json';
import equipment from '../data/pal/generated/equipment.json';
import shops from '../data/pal/generated/shops.json';
import locations from '../data/pal/generated/locations.json';
import treasures from '../data/pal/generated/treasures.json';
import npcs from '../data/pal/generated/npcs.json';
import enemies from '../data/pal/generated/enemies.json';
import magics from '../data/pal/generated/magics.json';
import itemSources from '../data/pal/generated/item_sources.json';

type Row = Record<string, any>;
const { kind = 'items' } = Astro.props as { kind?: string };

const nameOf = (r: Row) =>
  typeof r.name === 'string' ? r.name : (r.name?.zh ?? r.name?.en ?? `#${r.id}`);

const itemRows = (items as Row[]).map((r) => ({ ...(r as Row), _name: nameOf(r) })) as Row[];
const equipRows = (equipment as Row[]).map((r) => ({ ...(r as Row), _name: nameOf(r) })) as Row[];
const shopRows = shops as Row[];
const locationRows = locations as Row[];
const treasureRows = treasures as Row[];
const npcRows = npcs as Row[];
const enemyRows = enemies as Row[];
const magicRows = magics as Row[];
const sourceRows = (itemSources as Row[]).filter((r) => r.sourceCount > 0);

// 跨表互链：道具分散在「道具图鉴」和「装备图鉴」两页，先建 ID -> 页面锚点。
const ITEMS_PAGE = '/games/pal/items/';
const EQUIP_PAGE = '/games/pal/equipment/';
const SOURCES_PAGE = '/games/pal/item-sources/';
const SHOPS_PAGE = '/games/pal/shops/';
const SCENES_PAGE = '/games/pal/locations/';

const itemAnchor = new Map<string, string>();
for (const r of itemRows) itemAnchor.set(String(r.id), `${ITEMS_PAGE}#item-${r.id}`);
for (const r of equipRows) itemAnchor.set(String(r.id), `${EQUIP_PAGE}#item-${r.id}`);

// 只有确实有出处的道具才值得链去出处页（该页已过滤掉无出处的）。
const hasSource = new Set(sourceRows.map((r) => String(r.id)));

const itemHref = (id: unknown) => itemAnchor.get(String(id));
const sourceHref = (id: unknown) => (hasSource.has(String(id)) ? `${SOURCES_PAGE}#source-${id}` : undefined);
const shopHref = (id: unknown) => `${SHOPS_PAGE}#shop-${id}`;
const sceneHref = (id: unknown) => `${SCENES_PAGE}#scene-${id}`;

// 装备属性：只列非零项，形如「武术+2 身法+3」。
const statLine = (r: Row) =>
  (r.attributes ?? [])
    .filter((a: any) => a.value)
    .map((a: any) => `${a.name}${a.value > 0 ? '+' : ''}${a.value}`)
    .join(' ');

const firstLine = (s: string | undefined) => (s ?? '').split(String.fromCharCode(10))[0];

// 供搜索用的纯文本；展示用的可点版本见下方 sources 表格。
const sourceLine = (r: Row) =>
  [
    r.shops?.length && `商店 ${r.shops.map((s: any) => s.name).join('、')}`,
    r.gathers?.length && `采集 ${r.gathers.length} 处`,
    r.steals?.length && `可偷自 ${r.steals.map((s: any) => s.name).join('、')}`,
    r.startingGear?.length && `初始装备 ${r.startingGear.map((s: any) => s.name).join('、')}`,
  ]
    .filter(Boolean)
    .join(' · ');

const money = (v: number | null | undefined) =>
  v == null || v <= 0 ? '非卖品' : v.toLocaleString('zh-CN');

const unit =
  kind === 'npcs' ? '人' :
  kind === 'enemies' ? '种' :
  kind === 'magics' ? '个' :
  kind === 'treasures' ? '处' :
  kind === 'shops' ? '家' :
  kind === 'locations' ? '处' : '件';
---

<div class="pal-dt-wrap not-content" data-unit={unit}>
  <div class="pal-dt-bar">
    <input class="pal-dt-search" type="search" placeholder="搜索…" aria-label="搜索" />
    <span class="pal-dt-count" aria-live="polite"></span>
  </div>

  <div class="pal-dt-scroll">
    {kind === 'items' && (
      <table class="pal-dt">
        <thead>
          <tr>
            <th class="icon" />
            <th data-sort="id" class="num">ID</th>
            <th data-sort="name">名称</th>
            <th data-sort="price" class="num">价格</th>
            <th>效果</th>
            <th>说明</th>
          </tr>
        </thead>
        <tbody>
          {itemRows.map((r) => (
            <tr id={`item-${r.id}`} data-name={`${r._name} ${firstLine(r.description)}`} data-id={r.id} data-price={r.price ?? -1}>
              <td class="icon">{r.icon && <img src={r.icon} alt="" loading="lazy" width="32" height="32" />}</td>
              <td class="num muted">{r.id}</td>
              <td class="name">
                {sourceHref(r.id)
                  ? <a href={sourceHref(r.id)} title="查看出处">{r._name}</a>
                  : r._name}
              </td>
              <td class:list={['num', (r.price == null || r.price <= 0) && 'nosale']}>{money(r.price)}</td>
              <td class="muted">
                {[
                  r.healHP && `HP+${r.healHP}`,
                  r.healMP && `MP+${r.healMP}`,
                  r.status && `${r.status.name} ${r.status.rounds} 回合`,
                  r.throwMagic && `投掷 ${r.throwMagic.name}`,
                ].filter(Boolean).join(' · ') || (r.usable ? '可用' : '—')}
              </td>
              <td class="long muted">{firstLine(r.description) || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {kind === 'equipment' && (
      <table class="pal-dt">
        <thead>
          <tr>
            <th class="icon" />
            <th data-sort="id" class="num">ID</th>
            <th data-sort="name">名称</th>
            <th data-sort="slot">部位</th>
            <th data-sort="price" class="num">价格</th>
            <th>属性加成</th>
            <th>说明</th>
          </tr>
        </thead>
        <tbody>
          {equipRows.map((r) => (
            <tr
              data-name={`${r._name} ${r.equipSlot?.name ?? ''} ${statLine(r)}`}
              data-id={r.id}
              data-slot={r.equipSlot?.index ?? 9}
              data-price={r.price ?? -1}
              id={`item-${r.id}`}
            >
              <td class="icon">{r.icon && <img src={r.icon} alt="" loading="lazy" width="32" height="32" />}</td>
              <td class="num muted">{r.id}</td>
              <td class="name">
                {sourceHref(r.id)
                  ? <a href={sourceHref(r.id)} title="查看出处">{r._name}</a>
                  : r._name}
              </td>
              <td>{r.equipSlot?.name ?? '—'}</td>
              <td class:list={['num', (r.price == null || r.price <= 0) && 'nosale']}>{money(r.price)}</td>
              <td class="stats">{statLine(r) || '—'}</td>
              <td class="long muted">{firstLine(r.description) || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {kind === 'shops' && (
      <table class="pal-dt">
        <thead>
          <tr>
            <th data-sort="id" class="num">ID</th>
            <th data-sort="name">店主 / 名称</th>
            <th data-sort="scene">场景</th>
            <th>类型</th>
            <th>商品</th>
          </tr>
        </thead>
        <tbody>
          {shopRows.map((r) => (
            <tr
              data-name={`${r.name} ${r.sceneName ?? ''} ${(r.items ?? []).map((it: any) => it.name).join(' ')}`}
              data-id={r.id}
              data-scene={r.sceneId ?? 9999}
              id={`shop-${r.id}`}
            >
              <td class="num muted">{r.id}</td>
              <td class="name">{r.name}</td>
              <td>{r.sceneId ? <a href={sceneHref(r.sceneId)}>{r.sceneName}</a> : '—'}</td>
              <td class="muted">{r.kind === 'sell' ? '收购' : '买入'}</td>
              <td class="long">
                {(r.items ?? []).length
                  ? (r.items ?? []).map((it: any, i: number) => (
                      <>
                        {i > 0 && '、'}
                        {itemHref(it.id) ? <a href={itemHref(it.id)}>{it.name}</a> : it.name}
                      </>
                    ))
                  : '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {kind === 'locations' && (
      <table class="pal-dt">
        <thead>
          <tr>
            <th data-sort="id" class="num">场景</th>
            <th data-sort="name">名称</th>
            <th data-sort="map" class="num">地图号</th>
          </tr>
        </thead>
        <tbody>
          {locationRows.map((r) => (
            <tr id={`scene-${r.id}`} data-name={r.name} data-id={r.id} data-map={r.mapNum}>
              <td class="num muted">{r.id}</td>
              <td class="name">{r.name}</td>
              <td class="num">{r.mapNum}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {kind === 'treasures' && (
      <table class="pal-dt">
        <thead>
          <tr>
            <th data-sort="scene" class="num">场景</th>
            <th data-sort="name">道具</th>
            <th>提示文</th>
            <th data-sort="map" class="num">地图</th>
          </tr>
        </thead>
        <tbody>
          {treasureRows.map((r) => (
            <tr
              data-name={`${r.itemNames} ${r.sceneName} ${r.message}`}
              data-id={r.id}
              data-scene={r.sceneId}
              data-map={r.mapNum}
            >
              <td class="num muted"><a href={sceneHref(r.sceneId)}>{r.sceneId}</a></td>
              <td class="name">
                {(r.items ?? []).length
                  ? (r.items ?? []).map((it: any, i: number) => (
                      <>
                        {i > 0 && '、'}
                        {itemHref(it.id) ? <a href={itemHref(it.id)}>{it.name}</a> : it.name}
                      </>
                    ))
                  : '—'}
              </td>
              <td class="long muted">{r.message || '—'}</td>
              <td class="num">{r.mapNum}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {kind === 'npcs' && (
      <table class="pal-dt">
        <thead>
          <tr>
            <th data-sort="name">姓名</th>
            <th data-sort="count" class="num">出现</th>
            <th>场景</th>
            <th>身份</th>
          </tr>
        </thead>
        <tbody>
          {npcRows.map((r) => (
            <tr
              data-name={`${r.name} ${r.scenes} ${(r.kinds ?? []).join(' ')}`}
              data-id={r.name}
              data-count={r.appearanceCount}
            >
              <td class="name">{r.name}</td>
              <td class="num">{r.appearanceCount}</td>
              <td class="long">
                {(r.locations ?? []).length
                  ? [...new Set((r.locations ?? []).map((l: any) => l.sceneId))].map((sid: any, i: number) => (
                      <>
                        {i > 0 && '、'}
                        <a href={sceneHref(sid)}>{`场景 ${sid}`}</a>
                      </>
                    ))
                  : r.scenes}
              </td>
              <td class="muted">{(r.kinds ?? []).map((k: string) => ({ npc: 'NPC', shop: '商店', treasure: '道具' }[k] ?? k)).join(' · ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
    {kind === 'enemies' && (
      <table class="pal-dt">
        <thead>
          <tr>
            <th class="icon" />
            <th data-sort="name">名称</th>
            <th data-sort="level" class="num">等级</th>
            <th data-sort="health" class="num">体力</th>
            <th data-sort="exp" class="num">经验</th>
            <th data-sort="cash" class="num">金钱</th>
            <th>可偷</th>
            <th>出没场景</th>
          </tr>
        </thead>
        <tbody>
          {enemyRows.map((r) => (
            <tr
              data-name={`${r.name} ${r.stealItem?.name ?? ''}`}
              data-id={r.id}
              data-level={r.level}
              data-health={r.health}
              data-exp={r.exp}
              data-cash={r.cash}
              id={`enemy-${r.id}`}
            >
              <td class="icon">{r.spriteFile && <img src={r.spriteFile} alt="" loading="lazy" height="40" />}</td>
              <td class="name">{r.name}</td>
              <td class="num">{r.level}</td>
              <td class="num">{r.health.toLocaleString('zh-CN')}</td>
              <td class="num">{r.exp.toLocaleString('zh-CN')}</td>
              <td class="num">{r.cash.toLocaleString('zh-CN')}</td>
              <td class="muted">
                {r.stealItem
                  ? <>
                      {itemHref(r.stealItem.id)
                        ? <a href={itemHref(r.stealItem.id)}>{r.stealItem.name}</a>
                        : r.stealItem.name}
                      {r.stealAmount > 1 && ` ×${r.stealAmount}`}
                    </>
                  : '—'}
              </td>
              <td class="long muted">
                {r.sceneIds.length
                  ? <>
                      {r.sceneIds.slice(0, 6).map((sid: number, i: number) => (
                        <>
                          {i > 0 && '、'}
                          <a href={sceneHref(sid)}>{sid}</a>
                        </>
                      ))}
                      {r.sceneIds.length > 6 && ` … 共 ${r.sceneIds.length} 处`}
                    </>
                  : '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {kind === 'magics' && (
      <table class="pal-dt">
        <thead>
          <tr>
            <th data-sort="name">名称</th>
            <th data-sort="mp" class="num">消耗</th>
            <th data-sort="damage" class="num">威力</th>
            <th data-sort="element">属性</th>
            <th>类型</th>
            <th>说明</th>
          </tr>
        </thead>
        <tbody>
          {magicRows.map((r) => (
            <tr
              data-name={`${r.name} ${r.elementalName} ${r.typeName} ${firstLine(r.description)}`}
              data-id={r.id}
              data-mp={r.costMP}
              data-damage={r.specialEffect ? -1 : r.baseDamage}
              data-element={r.elemental}
              id={`magic-${r.id}`}
            >
              <td class="name">{r.name}</td>
              <td class="num">{r.costMP || '—'}</td>
              <td class="num">{r.specialEffect ? <span class="muted">特殊</span> : (r.baseDamage || '—')}</td>
              <td>{r.elementalName}</td>
              <td class="muted">{r.typeName}</td>
              <td class="long muted">{firstLine(r.description) || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {kind === 'sources' && (
      <table class="pal-dt">
        <thead>
          <tr>
            <th class="icon" />
            <th data-sort="id" class="num">ID</th>
            <th data-sort="name">道具</th>
            <th data-sort="count" class="num">来源数</th>
            <th>出处</th>
          </tr>
        </thead>
        <tbody>
          {sourceRows.map((r) => (
            <tr id={`source-${r.id}`} data-name={`${r.name} ${sourceLine(r)}`} data-id={r.id} data-count={r.sourceCount}>
              <td class="icon">{r.icon && <img src={r.icon} alt="" loading="lazy" width="32" height="32" />}</td>
              <td class="num muted">{r.id}</td>
              <td class="name">
                {itemHref(r.id) ? <a href={itemHref(r.id)}>{r.name}</a> : r.name}
              </td>
              <td class="num">{r.sourceCount}</td>
              <td class="long muted">
                {r.shops?.length > 0 && (
                  <span class="src">
                    <b>商店</b>
                    {r.shops.map((s: any, i: number) => (
                      <>{i > 0 && '、'}<a href={shopHref(s.shopId)}>{s.name}</a></>
                    ))}
                  </span>
                )}
                {r.gathers?.length > 0 && (
                  <span class="src">
                    <b>采集</b>
                    {r.gathers.slice(0, 6).map((g: any, i: number) => (
                      <>{i > 0 && '、'}<a href={sceneHref(g.sceneId)}>{g.sceneId}</a></>
                    ))}
                    {r.gathers.length > 6 && ` … 共 ${r.gathers.length} 处`}
                  </span>
                )}
                {r.steals?.length > 0 && (
                  <span class="src">
                    <b>可偷自</b>
                    {r.steals.map((s: any, i: number) => (
                      <>{i > 0 && '、'}<a href={`/games/pal/enemies/#enemy-${s.enemyId}`}>{s.name}</a></>
                    ))}
                  </span>
                )}
                {r.startingGear?.length > 0 && (
                  <span class="src">
                    <b>初始装备</b>
                    {r.startingGear.map((s: any) => s.name).join('、')}
                  </span>
                )}
                {r.sourceCount === 0 && '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</div>

<script>
  const root = document.currentScript?.previousElementSibling as HTMLElement | null;
  if (root?.classList.contains('pal-dt-wrap')) {
    const search = root.querySelector('.pal-dt-search') as HTMLInputElement | null;
    const count = root.querySelector('.pal-dt-count') as HTMLElement | null;
    const rows = [...root.querySelectorAll('tbody tr')] as HTMLTableRowElement[];
    const unit = root.dataset.unit || '件';
    const refresh = () => {
      const q = (search?.value || '').trim().toLowerCase();
      let n = 0;
      for (const tr of rows) {
        const ok = !q || (tr.dataset.name || '').toLowerCase().includes(q) || (tr.dataset.id || '').includes(q);
        tr.hidden = !ok;
        if (ok) n++;
      }
      if (count) count.textContent = `${n} ${unit}`;
    };
    search?.addEventListener('input', refresh);
    refresh();

    root.querySelectorAll('th[data-sort]').forEach((th) => {
      th.addEventListener('click', () => {
        const key = (th as HTMLElement).dataset.sort!;
        const tbody = root.querySelector('tbody')!;
        const sorted = [...rows].sort((a, b) => {
          const av = a.dataset[key] ?? a.dataset.name ?? '';
          const bv = b.dataset[key] ?? b.dataset.name ?? '';
          const an = Number(av), bn = Number(bv);
          if (!Number.isNaN(an) && !Number.isNaN(bn)) return an - bn;
          return String(av).localeCompare(String(bv), 'zh');
        });
        sorted.forEach((tr) => tbody.appendChild(tr));
      });
    });
  }
</script>

<style>
  .pal-dt-wrap { margin: 1rem 0 2rem; }
  .pal-dt-bar { display: flex; gap: 0.75rem; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; }
  .pal-dt-search {
    flex: 1; min-width: 12rem; padding: 0.45rem 0.7rem; border: 1px solid #c9d4dc;
    border-radius: 6px; background: #fff; color: #1a2b36;
  }
  .pal-dt-count { color: #5a6b76; font-size: 0.9rem; }
  .pal-dt-scroll { overflow-x: auto; border: 1px solid #d7e0e6; border-radius: 8px; }
  .pal-dt { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .pal-dt th, .pal-dt td { padding: 0.45rem 0.65rem; border-bottom: 1px solid #e6edf1; text-align: left; }
  .pal-dt th { background: #f4f8fa; cursor: pointer; white-space: nowrap; color: #3a4d58; }
  .pal-dt .num { text-align: right; font-variant-numeric: tabular-nums; }
  .pal-dt .name { font-weight: 600; color: #16303d; }
  .pal-dt .muted { color: #7a8b95; }
  .pal-dt .long { max-width: 28rem; }
  .pal-dt .nosale { color: #a07040; }
  .pal-dt .stats { color: #2f7d4f; white-space: nowrap; }
  .pal-dt th.icon, .pal-dt td.icon { width: 3rem; padding: 0.25rem 0.4rem; text-align: center; }
  .pal-dt td.icon img { display: block; margin: 0 auto; image-rendering: pixelated; max-height: 40px; width: auto; }
  :global([data-theme='dark']) .pal-dt .stats { color: #6cc48d; }
  .pal-dt a { color: #1ba0c9; text-decoration: none; }
  .pal-dt a:hover { text-decoration: underline; }
  .pal-dt .src { display: block; }
  .pal-dt .src b { color: #7a8b95; font-weight: 500; margin-right: 0.35rem; }
  /* 跨页跳转后高亮目标行，否则长表里根本找不到落点 */
  .pal-dt tr:target > td { background: #fff6d9; }
  .pal-dt tr:target > td:first-child { box-shadow: inset 3px 0 0 #23b7e5; }
  :global([data-theme='dark']) .pal-dt tr:target > td { background: #3a3320; }
  :global([data-theme='dark']) .pal-dt .src b { color: #7a7a7a; }
  :global([data-theme='dark']) .pal-dt-search { background: #1a242b; border-color: #33444e; color: #e8eef2; }
  :global([data-theme='dark']) .pal-dt th { background: #1a242b; color: #b7c6d0; }
  :global([data-theme='dark']) .pal-dt th, :global([data-theme='dark']) .pal-dt td { border-bottom-color: #2a3840; }
  :global([data-theme='dark']) .pal-dt-scroll { border-color: #2a3840; }
  :global([data-theme='dark']) .pal-dt .name { color: #e8eef2; }
</style>
