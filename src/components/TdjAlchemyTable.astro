---
import alchemy from '../data/sword-man/generated/alchemy.json';
import TdjEntityTooltip from './TdjEntityTooltip.astro';
import { cardFromAlchemy, tdjCardPayload } from '../lib/tdjEntities';

type DataRow = Record<string, any>;

const { kind } = Astro.props as { kind: 'equipment' | 'items' };
const rows = (alchemy as DataRow[]).filter((row) =>
  kind === 'items' ? row.productType === 0 : row.productType !== 0,
);
const signed = (value: number) => (value ? `${value > 0 ? '+' : ''}${value}` : '-');
const effectText = (row: DataRow) =>
  row.effect ? `${row.effect}${row.effectPower ? ` ${signed(row.effectPower)}` : ''}` : '-';
const atkDef = (row: DataRow) => {
  const attack = signed(row.attack);
  const defence = signed(row.defence);
  if (attack === '-' && defence === '-') return '-';
  return `${attack} / ${defence}`;
};
---

<p class="tdj-alchemy-count">
  共 {rows.length} 项配方；两项材料前后顺序可以互换。悬停炼化结果可看完整属性与说明。
</p>

<div class="tdj-table-scroll">
  {kind === 'equipment' ? (
    <table class="tdj-alchemy-table tdj-equipment-table">
      <thead>
        <tr>
          <th>材料一</th>
          <th>材料二</th>
          <th>炼化结果</th>
          <th>类型</th>
          <th>攻 / 防</th>
          <th>可装备角色</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td>{row.ingredient1.name}<small>#{row.ingredient1.id}</small></td>
            <td>{row.ingredient2.name}<small>#{row.ingredient2.id}</small></td>
            <td>
              <span
                class="tdj-item-name tdj-has-card"
                tabindex="0"
                data-tdj-card={tdjCardPayload(cardFromAlchemy(row))}
              >
                <strong>{row.productName}</strong>
                <small>#{row.productId}</small>
              </span>
            </td>
            <td>{row.productTypeLabel}</td>
            <td>{atkDef(row)}</td>
            <td>{row.equipCharacters.join('、') || '-'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <table class="tdj-alchemy-table tdj-item-table">
      <thead>
        <tr>
          <th>材料一</th>
          <th>材料二</th>
          <th>炼化结果</th>
          <th>效果</th>
          <th>价格</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td>{row.ingredient1.name}<small>#{row.ingredient1.id}</small></td>
            <td>{row.ingredient2.name}<small>#{row.ingredient2.id}</small></td>
            <td>
              <span
                class="tdj-item-name tdj-has-card"
                tabindex="0"
                data-tdj-card={tdjCardPayload(cardFromAlchemy(row))}
              >
                <strong>{row.productName}</strong>
                <small>#{row.productId}</small>
              </span>
            </td>
            <td>{effectText(row)}</td>
            <td>{row.price || '-'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</div>

<TdjEntityTooltip />

<style>
  .tdj-alchemy-count {
    color: var(--leaf-text-muted);
    font-size: 0.9rem;
  }

  .tdj-table-scroll {
    max-width: 100%;
    overflow-x: auto;
  }

  .tdj-alchemy-table {
    min-width: 40rem;
  }

  .tdj-equipment-table {
    min-width: 48rem;
  }

  .tdj-alchemy-table th {
    white-space: nowrap;
  }

  .tdj-alchemy-table td {
    vertical-align: top;
  }

  .tdj-item-name {
    display: inline-grid;
    gap: 0.08rem;
  }

  .tdj-alchemy-table strong {
    color: var(--leaf-heading);
  }

  .tdj-alchemy-table small {
    color: var(--leaf-text-muted);
    display: block;
    font-size: 0.78rem;
    margin-top: 0.08rem;
  }
</style>
