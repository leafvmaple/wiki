---
import crops from '../data/stardew-valley/generated/crops.json';
import fish from '../data/stardew-valley/generated/fish.json';
import villagers from '../data/stardew-valley/generated/villagers.json';
import bundles from '../data/stardew-valley/generated/bundles.json';
import machines from '../data/stardew-valley/generated/machines.json';
import StardewIcon from './StardewIcon.astro';
import StardewEntityTooltip from './StardewEntityTooltip.astro';

type DataRow = Record<string, any>;
type TimeRange = { start: number; end: number };

const cropRows = crops as DataRow[];
const fishRows = fish as DataRow[];
const villagerRows = villagers as DataRow[];
const bundleRows = bundles as DataRow[];
const machineRows = machines as DataRow[];
const bundleRooms = [...new Map(bundleRows.map((bundle) => [bundle.room, bundle.roomZh])).entries()];
const machineProfitRows: DataRow[] = machineRows.flatMap((machine) =>
  ((machine.profitRules ?? []) as DataRow[]).map((rule): DataRow => ({
    ...rule,
    machineId: rule.machineId ?? machine.id,
    machineNameZh: rule.machineNameZh ?? machine.nameZh,
  }))
);
const machineProfitMachines = [
  ...new Map(machineProfitRows.map((rule) => [rule.machineId, rule.machineNameZh])).entries(),
].sort((a, b) => String(a[1]).localeCompare(String(b[1])));

const seasonLabels: Record<string, string> = {
  spring: '春',
  summer: '夏',
  fall: '秋',
  winter: '冬',
  Spring: '春',
  Summer: '夏',
  Fall: '秋',
  Winter: '冬',
};
const weatherLabels: Record<string, string> = {
  sunny: '晴天',
  rainy: '雨天',
  both: '不限',
};
const methodLabels: Record<string, string> = {
  rod: '钓竿',
  trap: '蟹笼',
};
const qualityLabels: Record<string, string> = {
  '1': '银星',
  '2': '金星',
  '3': '铱星',
};

const joinList = (items?: string[], fallback = '-') => (items?.length ? items.join('、') : fallback);
const formatSeasons = (items?: string[]) => (items?.length ? items.map((item) => seasonLabels[item] ?? item).join('、') : '-');
const formatRanges = (ranges?: TimeRange[]) => ranges?.map((range) => `${range.start}-${range.end}`).join('|') ?? '';
const formatTime = (value: number) => {
  const hour = Math.floor(value / 100);
  const minute = value % 100;
  const displayHour = hour >= 24 ? hour - 24 : hour;
  const suffix = hour >= 24 ? ' +1' : '';
  return `${String(displayHour).padStart(2, '0')}:${String(minute).padStart(2, '0')}${suffix}`;
};
const formatTimeRanges = (ranges?: TimeRange[]) =>
  ranges?.length ? ranges.map((range) => `${formatTime(range.start)}-${formatTime(range.end)}`).join('、') : '-';
const formatLocations = (locations?: DataRow[]) =>
  locations?.length ? locations.map((location) => location.code).join('、') : '-';
const formatBirthday = (villager: DataRow) =>
  villager.birthSeason && villager.birthDay ? `${seasonLabels[villager.birthSeason] ?? villager.birthSeason} ${villager.birthDay}` : '-';
const seasonValue = (value?: string) => String(value ?? '').toLowerCase();
const formatReward = (reward?: DataRow | null) =>
  reward ? `${reward.label}${reward.quantity && reward.quantity > 1 ? ` x${reward.quantity}` : ''}` : '-';
const formatGold = (value?: number | null) => (Number.isFinite(Number(value)) ? `${Math.round(Number(value))}g` : '-');
const formatSignedGold = (value?: number | null) => {
  if (!Number.isFinite(Number(value))) return '-';
  const rounded = Math.round(Number(value));
  return `${rounded > 0 ? '+' : ''}${rounded}g`;
};
const formatCount = (count?: number | null) => (Number(count) > 1 ? ` x${count}` : '');
const formatBundleNeed = (item: DataRow) => {
  const quantity = item.label === '金币' ? `${item.quantity}g` : item.quantity > 1 ? `x${item.quantity}` : '';
  const quality = item.quality ? qualityLabels[String(item.quality)] : '';
  return [quantity, quality].filter(Boolean).join(' · ');
};
const formatOutputNote = (rule: DataRow) =>
  [rule.outputQualityLabel, rule.copyQuality ? '继承品质' : ''].filter(Boolean).join(' · ');
---

<div class="leaf-tools" data-stardew-tools>
  <section class="leaf-tool-panel">
    <h2>今日可钓鱼</h2>
    <div class="leaf-tool-controls">
      <label>
        <span>季节</span>
        <select data-fish-season>
          <option value="spring">春</option>
          <option value="summer">夏</option>
          <option value="fall">秋</option>
          <option value="winter">冬</option>
        </select>
      </label>
      <label>
        <span>天气</span>
        <select data-fish-weather>
          <option value="sunny">晴天</option>
          <option value="rainy">雨天</option>
        </select>
      </label>
      <label>
        <span>时间</span>
        <input data-fish-time type="number" min="600" max="2600" step="100" value="1200" />
      </label>
    </div>
    <p class="leaf-tool-count"><span data-fish-count>0</span> 条匹配</p>
    <table>
      <thead>
        <tr>
          <th>鱼类</th>
          <th>方式</th>
          <th>季节</th>
          <th>时间</th>
          <th>天气</th>
          <th>地点代码</th>
          <th>难度</th>
        </tr>
      </thead>
      <tbody>
        {fishRows.map((item) => (
          <tr
            data-fish-row
            data-seasons={(item.seasons ?? []).map(seasonValue).join(',')}
            data-weather={item.weather ?? 'both'}
            data-ranges={formatRanges(item.timeRanges)}
          >
            <td><StardewIcon kind="fish" assetKind="object" assetId={item.id} label={item.nameZh ?? item.name} /></td>
            <td>{methodLabels[item.method] ?? item.method}</td>
            <td>{formatSeasons(item.seasons)}</td>
            <td>{formatTimeRanges(item.timeRanges)}</td>
            <td>{weatherLabels[item.weather] ?? item.weather ?? '-'}</td>
            <td>{formatLocations(item.locationCodes)}</td>
            <td>{item.difficulty ?? '-'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="leaf-tool-panel">
    <h2>作物播种估算</h2>
    <div class="leaf-tool-controls">
      <label>
        <span>季节</span>
        <select data-crop-season>
          <option value="Spring">春</option>
          <option value="Summer">夏</option>
          <option value="Fall">秋</option>
          <option value="Winter">冬</option>
        </select>
      </label>
      <label>
        <span>播种日</span>
        <input data-crop-day type="number" min="1" max="28" step="1" value="1" />
      </label>
    </div>
    <p class="leaf-tool-count"><span data-crop-count>0</span> 种可在本季种植</p>
    <table>
      <thead>
        <tr>
          <th>种子</th>
          <th>收获物</th>
          <th>成熟</th>
          <th>再生</th>
          <th>最晚播种</th>
          <th>预计收获</th>
          <th>基础差值</th>
        </tr>
      </thead>
      <tbody>
        {cropRows.map((crop) => (
          <tr
            data-crop-row
            data-seasons={(crop.seasons ?? []).join(',')}
            data-grow-days={crop.growDays}
            data-regrow-days={crop.regrowDays}
            data-seed-price={crop.seedBasePrice ?? 0}
            data-harvest-value={crop.averageHarvestBaseValue ?? 0}
          >
            <td><StardewIcon kind="crop" assetKind="object" assetId={crop.seedId} label={crop.seedNameZh ?? crop.seedName} /></td>
            <td><StardewIcon kind="item" assetKind="object" assetId={crop.harvestItemId} label={crop.harvestNameZh ?? crop.harvestName} /></td>
            <td>{crop.growDays} 天</td>
            <td>{crop.regrowDays > 0 ? `${crop.regrowDays} 天` : '否'}</td>
            <td data-crop-last>-</td>
            <td data-crop-harvests>-</td>
            <td data-crop-profit>-</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="leaf-tool-panel">
    <h2>礼物快查</h2>
    <div class="leaf-tool-controls">
      <label class="is-wide">
        <span>搜索</span>
        <input data-gift-search type="search" placeholder="村民或礼物名" />
      </label>
      <label>
        <span>生日季节</span>
        <select data-gift-season>
          <option value="">全部</option>
          <option value="Spring">春</option>
          <option value="Summer">夏</option>
          <option value="Fall">秋</option>
          <option value="Winter">冬</option>
        </select>
      </label>
      <label>
        <span>日期</span>
        <input data-gift-day type="number" min="1" max="28" step="1" value="1" />
      </label>
      <label class="leaf-check">
        <input data-birthday-only type="checkbox" />
        <span>只看生日</span>
      </label>
    </div>
    <p class="leaf-tool-count"><span data-gift-count>0</span> 位匹配</p>
    <table>
      <thead>
        <tr>
          <th>村民</th>
          <th>生日</th>
          <th>可结婚</th>
          <th>最爱示例</th>
          <th>喜欢示例</th>
        </tr>
      </thead>
      <tbody>
        {villagerRows.map((villager) => (
          <tr
            data-gift-row
            data-name={`${villager.nameZh} ${villager.id}`}
            data-birth-season={villager.birthSeason ?? ''}
            data-birth-day={villager.birthDay ?? ''}
            data-gifts={`${joinList(villager.lovedItems, '')} ${joinList(villager.likedItems, '')}`}
          >
            <td><StardewIcon kind="npc" assetKind="npc" assetId={villager.id} label={villager.nameZh} /></td>
            <td>{formatBirthday(villager)}</td>
            <td>{villager.canBeRomanced ? '是' : '否'}</td>
            <td>
              <span class="sv-tool-chip-list">
                {((villager.lovedItems ?? []) as string[])
                  .slice(0, 6)
                  .map((item: string) => <StardewIcon kind="item" label={item} compact />)}
              </span>
            </td>
            <td>
              <span class="sv-tool-chip-list">
                {((villager.likedItems ?? []) as string[])
                  .slice(0, 6)
                  .map((item: string) => <StardewIcon kind="item" label={item} compact />)}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="leaf-tool-panel">
    <h2>收集包规划</h2>
    <div class="leaf-tool-controls">
      <label>
        <span>房间</span>
        <select data-bundle-room>
          <option value="">全部</option>
          {bundleRooms.map(([room, label]) => <option value={room}>{label}</option>)}
        </select>
      </label>
      <label class="is-wide">
        <span>搜索</span>
        <input data-bundle-search type="search" placeholder="物品或收集包" />
      </label>
      <label class="leaf-check">
        <input data-bundle-open-only type="checkbox" />
        <span>只看未完成</span>
      </label>
    </div>
    <p class="leaf-tool-count">
      <span data-bundle-count>0</span> 个收集包显示，剩余 <span data-bundle-remaining>0</span> 项，完成 <span data-bundle-complete>0</span> 个
    </p>
    <table class="leaf-bundle-table">
      <thead>
        <tr>
          <th>房间</th>
          <th>收集包</th>
          <th>需求</th>
          <th>进度</th>
        </tr>
      </thead>
      <tbody>
        {bundleRows.map((bundle) => (
          <tr
            data-bundle-row
            data-room={bundle.room}
            data-search={bundle.searchText}
            data-target={bundle.requiredCount}
          >
            <td>{bundle.roomZh}</td>
            <td>
              <strong>{bundle.nameZh}</strong>
              <small class="leaf-bundle-reward">奖励：{formatReward(bundle.reward)}</small>
            </td>
            <td>
              <span class="sv-tool-chip-list is-bundle">
                {(bundle.items as DataRow[]).map((item, index) => (
                  <label class="sv-bundle-item">
                    <input type="checkbox" data-bundle-item data-bundle-key={`${bundle.id}:${index}`} />
                    <StardewIcon
                      kind="item"
                      assetKind="object"
                      assetId={item.itemId}
                      label={item.label}
                      compact
                      link={false}
                    />
                    {formatBundleNeed(item) && <small>{formatBundleNeed(item)}</small>}
                  </label>
                ))}
              </span>
            </td>
            <td><span data-bundle-progress>0 / {bundle.requiredCount}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="leaf-tool-panel">
    <h2>机器加工收益</h2>
    <div class="leaf-tool-controls">
      <label>
        <span>机器</span>
        <select data-machine-profit-machine>
          <option value="">全部</option>
          {machineProfitMachines.map(([machineId, label]) => <option value={machineId}>{label}</option>)}
        </select>
      </label>
      <label class="is-wide">
        <span>搜索</span>
        <input data-machine-profit-search type="search" placeholder="物品或机器名" />
      </label>
      <label class="leaf-check">
        <input data-machine-profit-positive type="checkbox" />
        <span>只看正收益</span>
      </label>
    </div>
    <p class="leaf-tool-count">
      <span data-machine-profit-count>0</span> 条可计算规则，最高基础差值 <span data-machine-profit-best>-</span>
    </p>
    <table class="leaf-machine-profit-table">
      <thead>
        <tr>
          <th>机器</th>
          <th>输入</th>
          <th>输出</th>
          <th>加工时间</th>
          <th>成本</th>
          <th>产值</th>
          <th>基础差值</th>
        </tr>
      </thead>
      <tbody>
        {machineProfitRows.map((rule) => (
          <tr
            data-machine-profit-row
            data-machine={rule.machineId}
            data-search={rule.searchText}
            data-profit={rule.baseProfit}
          >
            <td>
              <StardewIcon
                kind="machine"
                assetKind="machine"
                assetId={rule.machineId}
                label={rule.machineNameZh}
              />
            </td>
            <td>
              <StardewIcon
                kind="item"
                assetKind="object"
                assetId={rule.inputItemId}
                label={`${rule.inputLabel}${formatCount(rule.inputCount)}`}
              />
              {((rule.extraInputs ?? []) as DataRow[]).length > 0 && (
                <span class="sv-machine-extra">
                  {((rule.extraInputs ?? []) as DataRow[]).map((item) => (
                    <StardewIcon
                      kind="item"
                      assetKind="object"
                      assetId={item.itemId}
                      label={`+ ${item.label}${formatCount(item.count)}`}
                      compact
                    />
                  ))}
                </span>
              )}
            </td>
            <td>
              <StardewIcon
                kind="item"
                assetKind="object"
                assetId={rule.outputItemId}
                label={`${rule.outputLabel}${formatCount(rule.outputCount)}`}
              />
              {formatOutputNote(rule) && <small class="sv-machine-note">{formatOutputNote(rule)}</small>}
            </td>
            <td>{rule.readyLabel ?? '-'}</td>
            <td>{formatGold(Number(rule.inputValue ?? 0) + Number(rule.extraInputValue ?? 0))}</td>
            <td>{formatGold(rule.outputValue)}</td>
            <td>
              <strong class:list={['sv-profit-value', rule.baseProfit >= 0 ? 'is-positive' : 'is-negative']}>
                {formatSignedGold(rule.baseProfit)}
              </strong>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</div>

<StardewEntityTooltip />

<script is:inline>
  (() => {
    const root = document.querySelector('[data-stardew-tools]');
    if (!root) return;

    const inTimeRange = (value, ranges) => {
      if (!ranges.length) return true;
      return ranges.some(([start, end]) => value >= start && value <= end);
    };
    const parseRanges = (value) =>
      value
        .split('|')
        .filter(Boolean)
        .map((range) => range.split('-').map(Number));
    const toNumber = (input) => Number(input.value || 0);
    const formatSignedGold = (value) => {
      if (!Number.isFinite(value)) return '-';
      const rounded = Math.round(value);
      return `${rounded > 0 ? '+' : ''}${rounded}g`;
    };
    const bundleStateKey = 'leafwiki:stardew:bundle-planner:v1';
    const readBundleState = () => {
      try {
        return JSON.parse(localStorage.getItem(bundleStateKey) || '{}');
      } catch {
        return {};
      }
    };
    const bundleState = readBundleState();
    const saveBundleState = () => localStorage.setItem(bundleStateKey, JSON.stringify(bundleState));

    const updateFish = () => {
      const season = root.querySelector('[data-fish-season]').value;
      const weather = root.querySelector('[data-fish-weather]').value;
      const time = toNumber(root.querySelector('[data-fish-time]'));
      let count = 0;
      for (const row of root.querySelectorAll('[data-fish-row]')) {
        const seasons = row.dataset.seasons.split(',').filter(Boolean);
        const ranges = parseRanges(row.dataset.ranges);
        const weatherOk = row.dataset.weather === 'both' || row.dataset.weather === weather || row.dataset.weather === '';
        const seasonOk = !seasons.length || seasons.includes(season);
        const timeOk = inTimeRange(time, ranges);
        const visible = weatherOk && seasonOk && timeOk;
        row.hidden = !visible;
        if (visible) count += 1;
      }
      root.querySelector('[data-fish-count]').textContent = String(count);
    };

    const updateCrops = () => {
      const season = root.querySelector('[data-crop-season]').value;
      const day = toNumber(root.querySelector('[data-crop-day]'));
      let count = 0;
      for (const row of root.querySelectorAll('[data-crop-row]')) {
        const seasons = row.dataset.seasons.split(',').filter(Boolean);
        const growDays = Number(row.dataset.growDays);
        const regrowDays = Number(row.dataset.regrowDays);
        const seedPrice = Number(row.dataset.seedPrice);
        const harvestValue = Number(row.dataset.harvestValue);
        const lastDay = 28 - growDays;
        const firstHarvest = day + growDays;
        const harvests =
          firstHarvest > 28 ? 0 : 1 + (regrowDays > 0 ? Math.floor((28 - firstHarvest) / regrowDays) : 0);
        const profit = harvests > 0 ? harvests * harvestValue - seedPrice : 0;
        const visible = seasons.includes(season);
        row.hidden = !visible;
        row.querySelector('[data-crop-last]').textContent = lastDay >= 1 ? String(lastDay) : '来不及';
        row.querySelector('[data-crop-harvests]').textContent = harvests > 0 ? `${harvests} 次` : '来不及';
        row.querySelector('[data-crop-profit]').textContent = harvests > 0 ? String(Math.round(profit)) : '-';
        if (visible) count += 1;
      }
      root.querySelector('[data-crop-count]').textContent = String(count);
    };

    const updateGifts = () => {
      const query = root.querySelector('[data-gift-search]').value.trim().toLowerCase();
      const season = root.querySelector('[data-gift-season]').value;
      const day = root.querySelector('[data-gift-day]').value;
      const birthdayOnly = root.querySelector('[data-birthday-only]').checked;
      let count = 0;
      for (const row of root.querySelectorAll('[data-gift-row]')) {
        const haystack = `${row.dataset.name} ${row.dataset.gifts}`.toLowerCase();
        const birthdayOk = !birthdayOnly || (row.dataset.birthSeason === season && row.dataset.birthDay === day);
        const queryOk = !query || haystack.includes(query);
        const visible = birthdayOk && queryOk;
        row.hidden = !visible;
        if (visible) count += 1;
      }
      root.querySelector('[data-gift-count]').textContent = String(count);
    };

    const updateBundles = () => {
      const query = root.querySelector('[data-bundle-search]').value.trim().toLowerCase();
      const room = root.querySelector('[data-bundle-room]').value;
      const openOnly = root.querySelector('[data-bundle-open-only]').checked;
      let visibleCount = 0;
      let remainingCount = 0;
      let completeCount = 0;

      for (const row of root.querySelectorAll('[data-bundle-row]')) {
        const target = Number(row.dataset.target || 0);
        const items = [...row.querySelectorAll('[data-bundle-item]')];
        const checked = items.filter((item) => item.checked).length;
        const done = Math.min(checked, target);
        const complete = done >= target;
        const roomOk = !room || row.dataset.room === room;
        const queryOk = !query || row.dataset.search.toLowerCase().includes(query);
        const visible = roomOk && queryOk && (!openOnly || !complete);

        row.hidden = !visible;
        row.dataset.complete = complete ? 'true' : 'false';
        row.querySelector('[data-bundle-progress]').textContent = `${done} / ${target}`;

        if (visible) {
          visibleCount += 1;
          remainingCount += Math.max(0, target - done);
        }
        if (complete) completeCount += 1;
      }

      root.querySelector('[data-bundle-count]').textContent = String(visibleCount);
      root.querySelector('[data-bundle-remaining]').textContent = String(remainingCount);
      root.querySelector('[data-bundle-complete]').textContent = String(completeCount);
    };

    const updateMachineProfit = () => {
      const query = root.querySelector('[data-machine-profit-search]').value.trim().toLowerCase();
      const machine = root.querySelector('[data-machine-profit-machine]').value;
      const positiveOnly = root.querySelector('[data-machine-profit-positive]').checked;
      let count = 0;
      let bestProfit = null;

      for (const row of root.querySelectorAll('[data-machine-profit-row]')) {
        const profit = Number(row.dataset.profit || 0);
        const machineOk = !machine || row.dataset.machine === machine;
        const queryOk = !query || row.dataset.search.includes(query);
        const profitOk = !positiveOnly || profit > 0;
        const visible = machineOk && queryOk && profitOk;

        row.hidden = !visible;
        if (visible) {
          count += 1;
          bestProfit = bestProfit === null ? profit : Math.max(bestProfit, profit);
        }
      }

      root.querySelector('[data-machine-profit-count]').textContent = String(count);
      root.querySelector('[data-machine-profit-best]').textContent =
        bestProfit === null ? '-' : formatSignedGold(bestProfit);
    };

    for (const input of root.querySelectorAll('[data-bundle-item]')) {
      input.checked = Boolean(bundleState[input.dataset.bundleKey]);
      input.addEventListener('change', () => {
        bundleState[input.dataset.bundleKey] = input.checked;
        saveBundleState();
        updateBundles();
      });
    }

    for (const input of root.querySelectorAll('select, input')) {
      input.addEventListener('input', () => {
        updateFish();
        updateCrops();
        updateGifts();
        updateBundles();
        updateMachineProfit();
      });
      input.addEventListener('change', () => {
        updateFish();
        updateCrops();
        updateGifts();
        updateBundles();
        updateMachineProfit();
      });
    }

    updateFish();
    updateCrops();
    updateGifts();
    updateBundles();
    updateMachineProfit();
  })();
</script>

<style>
  .leaf-tools {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0;
  }

  .leaf-tool-panel {
    border: 1px solid var(--leaf-border);
    border-radius: var(--leaf-radius-card);
    background: var(--leaf-bg-card);
    box-shadow: var(--leaf-shadow-card);
    overflow: hidden;
