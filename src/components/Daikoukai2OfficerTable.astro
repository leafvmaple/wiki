---
import { daikoukai2Officers } from '../data/daikoukai2/officers';

const statLabels = {
  leadership: '统率',
  navigation: '航海',
  knowledge: '知识',
  intuition: '直觉',
  courage: '勇气',
  swordsmanship: '剑术',
  charm: '魅力',
} as const;

const skillLabels = [
  [0x01, '交'],
  [0x02, '会'],
  [0x04, '砲'],
  [0x08, '地'],
  [0x10, '測'],
] as const;

const rows = daikoukai2Officers.map((officer) => {
  const stats = Object.entries(officer.stats) as Array<[
    keyof typeof officer.stats,
    number,
  ]>;
  const [strongestKey, strongestValue] = stats.reduce((best, current) =>
    current[1] > best[1] ? current : best,
  );
  const grade = (officer.navigationLevel + officer.battleLevel) * strongestValue;
  const salaryMin = Math.min(20, Math.floor(grade / 400) + 1) * 10;
  const salaryMax = Math.min(20, Math.floor(grade / 400) + 3) * 10;
  const skills = skillLabels.filter(([flag]) => officer.skillFlags & flag).map(([, label]) => label);
  const drinks = officer.facility === '宿屋'
    ? '无需'
    : officer.friendly ? '1 / 3' : '2 / 6';
  return {
    ...officer,
    strongestKey,
    strongestLabel: statLabels[strongestKey],
    strongestValue,
    grade,
    salaryMin,
    salaryMax,
    salaryText: salaryMin === salaryMax ? String(salaryMin) : `${salaryMin}–${salaryMax}`,
    skills,
    skillText: skills.join('・') || '—',
    drinks,
  };
});

const facilities = ['酒场', '宿屋'];
const nationalities = [...new Set(rows.map((row) => row.nationality))];
---

<div class="dk2-officers not-content" data-unit="人">
  <section class="dk2-officers-calculator" aria-label="雇佣成功率计算器">
    <div class="dk2-officers-calculator-intro">
      <strong>雇佣成功率计算器</strong>
      <p>输入主角当前数据，表格会按每名航海士的最强能力实时计算单次邀请成功率。</p>
    </div>

    <form class="dk2-officers-player" autocomplete="off">
      <fieldset>
        <legend>等级与爵位</legend>
        <label>
          <span>航海 Lv</span>
          <input type="number" min="0" max="100" step="1" value="1" inputmode="numeric" data-player-field="navigationLevel" />
        </label>
        <label>
          <span>战斗 Lv</span>
          <input type="number" min="0" max="100" step="1" value="1" inputmode="numeric" data-player-field="battleLevel" />
        </label>
        <label>
          <span>爵位等级</span>
          <input type="number" min="0" max="9" step="1" value="0" inputmode="numeric" data-player-field="titleLevel" aria-describedby="dk2-title-level-help" />
        </label>
        <small id="dk2-title-level-help">无爵位填 0；每升一级填 1，门槛增加 10%。</small>
      </fieldset>

      <fieldset class="dk2-officers-player-stats">
        <legend>七项能力</legend>
        {Object.entries(statLabels).map(([key, label]) => (
          <label>
            <span>{label}</span>
            <input
              type="number"
              min="0"
              max="100"
              step="1"
              value={({ leadership: 80, navigation: 86, knowledge: 84, intuition: 65, courage: 53, swordsmanship: 42, charm: 80 } as Record<string, number>)[key]}
              inputmode="numeric"
              data-player-field={key}
            />
          </label>
        ))}
      </fieldset>

      <div class="dk2-officers-player-actions">
        <label class="dk2-officers-checkbox">
          <input type="checkbox" checked data-player-field="hasRosterSpace" />
          <span>同伴表有空位</span>
        </label>
        <button type="button" class="dk2-officers-reset">恢复阿尔开局值</button>
      </div>
      <output class="dk2-officers-calculator-result" aria-live="polite"></output>
    </form>
  </section>

  <div class="dk2-officers-bar">
    <select class="dk2-officers-facility" aria-label="按设施筛选">
      <option value="">全部设施</option>
      {facilities.map((facility) => <option value={facility}>{facility}</option>)}
    </select>
    <select class="dk2-officers-nationality" aria-label="按国籍筛选">
      <option value="">全部国籍</option>
      {nationalities.map((nationality) => <option value={nationality}>{nationality}</option>)}
    </select>
    <input class="dk2-officers-search" type="search" placeholder="搜索姓名、港口或技能…" aria-label="搜索航海士" />
    <span class="dk2-officers-count" aria-live="polite"></span>
  </div>

  <div class="dk2-officers-scroll">
    <table class="dk2-officers-table">
      <thead>
        <tr>
          <th data-sort="id" class="num">ID</th>
          <th data-sort="name">航海士</th>
          <th data-sort="port">初始港口</th>
          <th data-sort="facility">设施</th>
          <th data-sort="nationality">国籍</th>
          <th data-sort="nav" class="num">航Lv</th>
          <th data-sort="battle" class="num">战Lv</th>
          <th data-sort="strongest" class="num">最强能力</th>
          <th data-sort="grade" class="num">格值 C</th>
          <th data-sort="player" class="num">你的门槛 P</th>
          <th data-sort="chance" class="num">成功率</th>
          <th data-sort="personality">性格</th>
          <th data-sort="friendly">义理</th>
          <th data-sort="drinks" class="num">同 / 异性格请酒</th>
          <th data-sort="salary" class="num">月薪</th>
          <th>技能</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr
            data-id={row.id}
            data-name={row.nameJa}
            data-port={row.port}
            data-facility={row.facility}
            data-nationality={row.nationality}
            data-nav={row.navigationLevel}
            data-battle={row.battleLevel}
            data-strongest={row.strongestValue}
            data-strongest-key={row.strongestKey}
            data-strongest-label={row.strongestLabel}
            data-grade={row.grade}
            data-player="0"
            data-chance="0"
            data-personality={row.personality}
            data-friendly={row.friendly ? 1 : 0}
            data-drinks={row.facility === '宿屋' ? 0 : row.friendly ? 1 : 2}
            data-salary={row.salaryMin}
            data-search={`${row.nameJa} ${row.port} ${row.facility} ${row.nationality} ${row.skillText}`}
          >
            <td class="num dk2-officers-id">{row.id.toString(16).toUpperCase().padStart(2, '0')}</td>
            <td class="dk2-officers-name">
              <span class="dk2-officers-identity">
                {row.portraitUrl ? (
                  <img
                    class="dk2-officers-portrait"
                    src={row.portraitUrl}
                    alt=""
                    width="64"
                    height="80"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="dk2-officers-portrait is-composite" aria-hidden="true">组</span>
                )}
                <span>{row.nameJa}</span>
              </span>
            </td>
            <td>{row.port}</td>
            <td><span class:list={['dk2-officers-facility-chip', row.facility === '宿屋' && 'is-inn']}>{row.facility}</span></td>
            <td class="muted">{row.nationality}</td>
            <td class="num">{row.navigationLevel}</td>
            <td class="num">{row.battleLevel}</td>
            <td class="num"><span class="dk2-officers-stat">{row.strongestLabel}</span>{row.strongestValue}</td>
            <td class="num dk2-officers-grade">{row.grade.toLocaleString('en-US')}</td>
            <td class="num dk2-officers-player-grade">—</td>
            <td class="num dk2-officers-chance"><strong>—</strong></td>
            <td>{row.personality}</td>
            <td>{row.friendly ? '有' : '—'}</td>
            <td class="num">{row.drinks}</td>
            <td class="num">{row.salaryText}</td>
            <td class="dk2-officers-skills">{row.skillText}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.dk2-officers').forEach((root) => {
    const table = root.querySelector<HTMLTableElement>('table');
    const tbody = table?.querySelector('tbody');
    if (!table || !tbody) return;
    const rows = [...tbody.querySelectorAll<HTMLElement>('tr')];
    const facility = root.querySelector<HTMLSelectElement>('.dk2-officers-facility');
    const nationality = root.querySelector<HTMLSelectElement>('.dk2-officers-nationality');
    const search = root.querySelector<HTMLInputElement>('.dk2-officers-search');
    const count = root.querySelector<HTMLElement>('.dk2-officers-count');
    const calculatorResult = root.querySelector<HTMLOutputElement>('.dk2-officers-calculator-result');
    const playerInputs = [...root.querySelectorAll<HTMLInputElement>('[data-player-field]')];
    const reset = root.querySelector<HTMLButtonElement>('.dk2-officers-reset');
    const storageKey = 'daikoukai2-officer-calculator-v1';
    const defaults: Record<string, number | boolean> = {
      navigationLevel: 1,
      battleLevel: 1,
      titleLevel: 0,
      leadership: 80,
      navigation: 86,
      knowledge: 84,
      intuition: 65,
      courage: 53,
      swordsmanship: 42,
      charm: 80,
      hasRosterSpace: true,
    };
    let sortKey = '';
    let sortDir = 1;

    const setPlayerValues = (values: Record<string, unknown>) => {
      for (const input of playerInputs) {
        const key = input.dataset.playerField ?? '';
        const value = values[key];
        if (input.type === 'checkbox') input.checked = typeof value === 'boolean' ? value : true;
        else if (typeof value === 'number' && Number.isFinite(value)) input.value = String(value);
      }
    };

    try {
      const saved = JSON.parse(localStorage.getItem(storageKey) ?? 'null');
      if (saved && typeof saved === 'object') setPlayerValues({ ...defaults, ...saved });
    } catch {
      // 无法读取本地设置时继续使用页面默认值。
    }

    const readInteger = (key: string, fallback: number) => {
      const input = playerInputs.find((item) => item.dataset.playerField === key);
      const value = input?.valueAsNumber;
      if (value === undefined || !Number.isFinite(value)) return fallback;
      const min = input?.min === '' ? Number.MIN_SAFE_INTEGER : Number(input?.min);
      const max = input?.max === '' ? Number.MAX_SAFE_INTEGER : Number(input?.max);
      return Math.min(max, Math.max(min, Math.trunc(value)));
    };

    const updateCalculator = (persist = true) => {
      const navigationLevel = readInteger('navigationLevel', 1);
      const battleLevel = readInteger('battleLevel', 1);
      const titleLevel = readInteger('titleLevel', 0);
      const levelTotal = navigationLevel + battleLevel;
      const playerStats: Record<string, number> = {
        leadership: readInteger('leadership', 80),
        navigation: readInteger('navigation', 86),
        knowledge: readInteger('knowledge', 84),
        intuition: readInteger('intuition', 65),
        courage: readInteger('courage', 53),
        swordsmanship: readInteger('swordsmanship', 42),
        charm: readInteger('charm', 80),
      };
      const rosterInput = playerInputs.find((item) => item.dataset.playerField === 'hasRosterSpace');
      const hasRosterSpace = rosterInput?.checked ?? true;
      let possible = 0;
      let guaranteed = 0;

      for (const row of rows) {
        const statKey = row.dataset.strongestKey ?? '';
        const statValue = playerStats[statKey] ?? 0;
        const candidateGrade = Number(row.dataset.grade ?? 0);
        const baseGrade = levelTotal * statValue;
        const playerGrade = baseGrade + Math.floor(baseGrade * titleLevel / 10);
        const chance = hasRosterSpace
          ? Math.min(20, Math.max(0, playerGrade - candidateGrade)) * 5
          : -1;
        const playerCell = row.querySelector<HTMLElement>('.dk2-officers-player-grade');
        const chanceCell = row.querySelector<HTMLElement>('.dk2-officers-chance');
        const chanceValue = chanceCell?.querySelector<HTMLElement>('strong');

        row.dataset.player = String(playerGrade);
        row.dataset.chance = String(chance);
        if (playerCell) playerCell.textContent = playerGrade.toLocaleString('en-US');
        if (chanceCell && chanceValue) {
          chanceValue.textContent = chance < 0 ? '不可邀请' : `${chance}%`;
          chanceCell.classList.toggle('is-zero', chance === 0);
          chanceCell.classList.toggle('is-partial', chance > 0 && chance < 100);
          chanceCell.classList.toggle('is-full', chance === 100);
          chanceCell.title = chance < 0
            ? '同伴表没有空位，邀请会在实力判定前失败'
            : `${row.dataset.strongestLabel}：P ${playerGrade} / C ${candidateGrade}`;
        }
        if (chance > 0) possible += 1;
        if (chance === 100) guaranteed += 1;
      }

      if (calculatorResult) {
        calculatorResult.textContent = hasRosterSpace
          ? `当前有 ${possible} 人具备成功率，其中 ${guaranteed} 人为 100%；每档相差 5%。`
          : '同伴表没有空位时，所有普通邀请都会在实力判定前失败。';
      }

      if (persist) {
        const saved = { navigationLevel, battleLevel, titleLevel, ...playerStats, hasRosterSpace };
        try {
          localStorage.setItem(storageKey, JSON.stringify(saved));
        } catch {
          // 禁用本地存储不影响计算。
        }
      }
    };

    const apply = () => {
      const facilityValue = facility?.value ?? '';
      const nationalityValue = nationality?.value ?? '';
      const query = search?.value.trim().toLocaleLowerCase('ja') ?? '';
      let shown = 0;
      for (const row of rows) {
        const matches =
          (!facilityValue || row.dataset.facility === facilityValue) &&
          (!nationalityValue || row.dataset.nationality === nationalityValue) &&
          (!query || (row.dataset.search ?? '').toLocaleLowerCase('ja').includes(query));
        row.hidden = !matches;
        if (matches) shown += 1;
      }
      if (count) count.textContent = `${shown} 人`;
    };

    const sortBy = (heading: HTMLElement) => {
      const key = heading.dataset.sort;
      if (!key) return;
      if (sortKey === key) sortDir *= -1;
      else {
        sortKey = key;
        sortDir = heading.classList.contains('num') ? -1 : 1;
      }
      const numeric = heading.classList.contains('num');
      [...rows]
        .sort((a, b) => {
          const av = a.dataset[key] ?? '';
          const bv = b.dataset[key] ?? '';
          return numeric
            ? (Number(av) - Number(bv)) * sortDir
            : av.localeCompare(bv, 'ja') * sortDir;
        })
        .forEach((row) => tbody.appendChild(row));
      table.querySelectorAll<HTMLElement>('th[data-sort]').forEach((item) => {
        item.dataset.dir = item.dataset.sort === key ? (sortDir > 0 ? 'asc' : 'desc') : '';
      });
    };

    facility?.addEventListener('change', apply);
    nationality?.addEventListener('change', apply);
    search?.addEventListener('input', apply);
    playerInputs.forEach((input) => {
      input.addEventListener(input.type === 'checkbox' ? 'change' : 'input', () => updateCalculator());
    });
    reset?.addEventListener('click', () => {
      setPlayerValues(defaults);
      updateCalculator();
    });
    table.querySelectorAll<HTMLElement>('th[data-sort]').forEach((heading) => {
      heading.addEventListener('click', () => sortBy(heading));
    });
    updateCalculator(false);
    apply();
  });
</script>

<style>
  .dk2-officers {
    display: grid;
    gap: 0.7rem;
    margin: 1rem 0;
  }

  .dk2-officers-calculator {
    background: var(--leaf-bg-card);
    border: 1px solid var(--leaf-border);
    border-radius: var(--leaf-radius-card);
    box-shadow: var(--leaf-shadow-card);
    display: grid;
    gap: 0.85rem;
    padding: 0.9rem;
  }

  .dk2-officers-calculator-intro strong {
    color: var(--leaf-heading);
    font-size: 1rem;
  }

  .dk2-officers-calculator-intro p {
    color: var(--leaf-text-muted);
    font-size: 0.88rem;
    margin: 0.15rem 0 0;
  }

  .dk2-officers-player {
    display: grid;
    gap: 0.75rem;
  }

  .dk2-officers-player fieldset {
    border: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    min-width: 0;
    padding: 0;
  }

  .dk2-officers-player legend {
    color: var(--leaf-text-muted);
    font-size: 0.78rem;
    font-weight: 800;
    margin-bottom: 0.38rem;
    padding: 0;
    width: 100%;
  }

  .dk2-officers-player label:not(.dk2-officers-checkbox) {
    display: grid;
    gap: 0.18rem;
  }

  .dk2-officers-player label > span {
    color: var(--leaf-text-muted);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .dk2-officers-player input[type='number'] {
    background: var(--leaf-bg-card);
    border: 1px solid var(--leaf-border);
    border-radius: var(--leaf-radius-card);
    color: var(--leaf-text);
    font: inherit;
    font-variant-numeric: tabular-nums;
    padding: 0.36rem 0.45rem;
    width: 5.25rem;
  }

  .dk2-officers-player input:focus-visible,
  .dk2-officers-reset:focus-visible {
    border-color: var(--leaf-primary);
    outline: 2px solid color-mix(in srgb, var(--leaf-primary) 30%, transparent);
    outline-offset: 1px;
  }

  .dk2-officers-player fieldset > small {
    align-self: end;
    color: var(--leaf-text-muted);
    font-size: 0.76rem;
    padding-bottom: 0.38rem;
  }

  .dk2-officers-player-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .dk2-officers-checkbox {
    align-items: center;
    display: inline-flex;
    gap: 0.4rem;
  }

  .dk2-officers-checkbox input {
    accent-color: var(--leaf-primary);
    height: 1rem;
    width: 1rem;
  }

  .dk2-officers-reset {
    background: var(--leaf-bg-subtle);
    border: 1px solid var(--leaf-border);
    border-radius: var(--leaf-radius-card);
    color: var(--leaf-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.34rem 0.58rem;
  }

  .dk2-officers-reset:hover {
    border-color: var(--leaf-primary);
    color: var(--leaf-primary-hover);
  }

  .dk2-officers-calculator-result {
    color: var(--leaf-heading);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .dk2-officers-bar {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .dk2-officers-bar :is(select, input) {
    border: 1px solid var(--leaf-border);
    border-radius: var(--leaf-radius-card);
    background: var(--leaf-bg-card);
    color: var(--leaf-text);
    font: inherit;
    font-size: 0.9rem;
    padding: 0.38rem 0.6rem;
  }

  .dk2-officers-search {
    flex: 1 1 14rem;
    max-width: 24rem;
  }

  .dk2-officers-count {
    color: var(--leaf-text-muted);
    font-size: 0.85rem;
    font-weight: 700;
    margin-left: auto;
  }

  .dk2-officers-scroll {
    border: 1px solid var(--leaf-border);
    border-radius: var(--leaf-radius-card);
    overflow-x: auto;
  }

  .dk2-officers-table {
    border-collapse: collapse;
    font-size: 0.88rem;
    min-width: 76rem;
    width: 100%;
  }

  .dk2-officers-table :is(th, td) {
    border-bottom: 1px solid var(--leaf-border);
    padding: 0.43rem 0.58rem;
    text-align: left;
    vertical-align: middle;
    white-space: nowrap;
  }

  .dk2-officers-table th {
    background: var(--leaf-bg-subtle);
    color: var(--leaf-text-muted);
    font-weight: 800;
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .dk2-officers-table th[data-sort] {
    cursor: pointer;
    user-select: none;
  }

  .dk2-officers-table th[data-sort]:hover {
    color: var(--leaf-primary-hover);
  }

  .dk2-officers-table th[data-sort]::after {
    content: ' ↕';
    opacity: 0.28;
  }

  .dk2-officers-table th[data-dir='asc']::after {
    content: ' ↑';
    opacity: 1;
  }

  .dk2-officers-table th[data-dir='desc']::after {
    content: ' ↓';
    opacity: 1;
  }

  .dk2-officers-table tbody tr:nth-child(even) {
    background: var(--leaf-table-stripe);
  }

  .dk2-officers-table tbody tr:hover {
    background: var(--leaf-table-hover);
  }

  .dk2-officers-table .num {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .dk2-officers-name,
  .dk2-officers-grade {
    color: var(--leaf-heading);
    font-weight: 700;
  }

  .dk2-officers-identity {
    align-items: center;
    display: inline-flex;
    gap: 0.48rem;
  }

  .dk2-officers-portrait {
    background: #000;
    border: 1px solid color-mix(in srgb, var(--leaf-border) 78%, #000);
    border-radius: 0.2rem;
    box-sizing: border-box;
    flex: 0 0 auto;
    height: 2.5rem;
    image-rendering: pixelated;
    object-fit: cover;
    width: 2rem;
  }

  .dk2-officers-portrait.is-composite {
    align-items: center;
    color: var(--leaf-text-muted);
    display: inline-flex;
    font-size: 0.7rem;
    justify-content: center;
  }

  .dk2-officers-id,
  .dk2-officers-table .muted,
  .dk2-officers-skills {
    color: var(--leaf-text-muted);
  }

  .dk2-officers-stat {
    color: var(--leaf-text-muted);
    font-size: 0.78rem;
    margin-right: 0.25rem;
  }

  .dk2-officers-facility-chip {
    border: 1px solid color-mix(in srgb, #d28b37 48%, var(--leaf-border));
    border-radius: 999px;
    color: #b66a1c;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.06rem 0.42rem;
  }

  .dk2-officers-facility-chip.is-inn {
    border-color: color-mix(in srgb, var(--leaf-primary) 48%, var(--leaf-border));
    color: var(--leaf-primary-hover);
  }

  :root[data-theme='dark'] .dk2-officers-facility-chip {
    color: #f0bd7a;
  }

  :root[data-theme='dark'] .dk2-officers-facility-chip.is-inn {
    color: #8be2fa;
  }

  .dk2-officers-chance strong {
    border-radius: 999px;
    display: inline-block;
    font-size: 0.8rem;
    min-width: 3.4rem;
    padding: 0.08rem 0.4rem;
    text-align: center;
